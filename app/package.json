{
  "name": "gearcard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "tsx ../scripts/validate-data.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run typecheck && vitest run",
    "build": "npm run validate && npm run typecheck && node ../scripts/build.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "ajv": "^8.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.0"
  }
}
